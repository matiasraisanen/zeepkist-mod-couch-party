<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>CouchParty</AssemblyName>
    <RootNamespace>CouchParty</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Version>0.9.0</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- The game's stripped reference libs ship their own mscorlib etc. -->
    <NoWarn>$(NoWarn);MSB3277;CS0436</NoWarn>
  </PropertyGroup>

  <!--
    Folder that contains BepInEx.dll and 0Harmony.dll.
    On Windows this is normally <Zeepkist install folder>\BepInEx\core.
    Override with:  dotnet build -p:BepInExCoreDir="D:\path\to\BepInEx\core"
  -->
  <PropertyGroup>
    <BepInExCoreDir Condition="'$(BepInExCoreDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Zeepkist\BepInEx\core</BepInExCoreDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="ZeepSDK" Version="2.7.6" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Zeepkist.GameLibs" Version="18.10.2087" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- The game libs contain both mscorlib's Span types and System.Memory's; Imui uses mscorlib's. -->
  <Target Name="DropDuplicateSystemMemory" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferencePath Remove="@(ReferencePath)" Condition="'%(Filename)' == 'System.Memory'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCoreDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCoreDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
